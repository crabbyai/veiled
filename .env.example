# ─── Veiled app (Expo) public config ────────────────────────────────
# All EXPO_PUBLIC_* vars are embedded in the client bundle. Never put
# server secrets here — only public keys/DSNs meant for the app.

# Backend API base (enables online mode; unset = offline demo)
EXPO_PUBLIC_API_URL=https://api.veiledapp.com

# In-app purchases (RevenueCat public SDK keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Crash reporting (Sentry DSN — public)
EXPO_PUBLIC_SENTRY_DSN=

# Product analytics (PostHog public project key)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com
