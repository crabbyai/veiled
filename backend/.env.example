# ─── Veiled backend configuration ───────────────────────────────────
PORT=3000
NODE_ENV=production
# REQUIRED in production — sign JWTs with a long random secret
JWT_SECRET=change-me-to-a-long-random-string
# Optional: persistent paths (mount volumes in prod)
# DB_PATH=/data/veiled.db
# UPLOAD_DIR=/data/uploads

# ─── Photo storage (S3-compatible) ──────────────────────────────────
# Leave unset to store photos on local disk (dev only).
# Install: npm i @aws-sdk/client-s3
# STORAGE_PROVIDER=s3
# S3_BUCKET=veiled-media
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=            # for Cloudflare R2 / DigitalOcean Spaces / MinIO
# S3_PUBLIC_BASE_URL=     # CDN base, e.g. https://cdn.veiledapp.com

# ─── Content moderation ─────────────────────────────────────────────
# Images: Hive or AWS Rekognition. Text: always-on basic filter + list.
# MODERATION_PROVIDER=hive
# HIVE_API_KEY=
# MODERATION_PROVIDER=rekognition   # install: npm i @aws-sdk/client-rekognition
# AWS_REKOGNITION_REGION=us-east-1
# TEXT_BLOCKLIST=word1,word2

# ─── Transactional email ────────────────────────────────────────────
# EMAIL_PROVIDER=smtp               # install: npm i nodemailer
# EMAIL_FROM=Veiled <no-reply@veiledapp.com>
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_PROVIDER=postmark
# POSTMARK_TOKEN=

# ─── Payments / IAP (Veiled Gold, Roses) ────────────────────────────
# Recommended: RevenueCat (handles StoreKit + Play Billing + webhooks).
# PAYMENTS_PROVIDER=revenuecat
# REVENUECAT_WEBHOOK_SECRET=          # match the value in RevenueCat dashboard
# APPLE_IAP_SHARED_SECRET=            # App Store Connect (direct receipt checks)
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=   # JSON string; install: npm i googleapis
# ANDROID_PACKAGE=com.veiledapp.hijabimarriage
# Product IDs (must match App Store Connect / Play Console):
# PRODUCT_GOLD_MONTHLY=com.veiledapp.gold.monthly
# PRODUCT_GOLD_ANNUAL=com.veiledapp.gold.annual
# PRODUCT_ROSES_3=com.veiledapp.roses.3
# PRODUCT_ROSES_12=com.veiledapp.roses.12

# ─── Identity / selfie verification ─────────────────────────────────
# VERIFICATION_PROVIDER=persona
# PERSONA_API_KEY=
# PERSONA_TEMPLATE_ID=
# PERSONA_WEBHOOK_SECRET=
# VERIFICATION_PROVIDER=onfido
# ONFIDO_API_TOKEN=
# ONFIDO_WEBHOOK_TOKEN=

# ─── Geocoding (real distances + Passport) ──────────────────────────
# GEO_PROVIDER=google
# GOOGLE_MAPS_API_KEY=
# GEO_PROVIDER=mapbox
# MAPBOX_TOKEN=

# ─── Phone verification (OTP) ───────────────────────────────────────
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# TWILIO_FROM_NUMBER=

# ─── Analytics (server-side) ────────────────────────────────────────
# ANALYTICS_PROVIDER=posthog
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://app.posthog.com
