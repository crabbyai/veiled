# Veiled backend configuration
PORT=3000
# REQUIRED in production — sign JWTs with a long random secret
JWT_SECRET=change-me-to-a-long-random-string
# Optional: override where the SQLite database file lives (e.g. a mounted volume)
# DB_PATH=/data/veiled.db
# Optional: override where uploaded photos are stored (e.g. a mounted volume)
# UPLOAD_DIR=/data/uploads
